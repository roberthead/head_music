                  <note xml:id="m1-p1v1-b2c3" pname="a" oct="5" dur="4"/>
                </layer>
              </staff>
              <staff xml:id="m1-staff-b2s2" n="2">
                <layer xml:id="m1-layer-b2s2l1" n="1">
                  <note xml:id="m1-p2v1-b2c1" pname="d" oct="3" dur="2" dots="1"/>
                </layer>
              </staff>
              <dynam xml:id="m1-dynam-p1-b2c3" tstamp="3" staff="1">f</dynam>
            </measure>
            <measure xml:id="m1-measure-b3" n="3">
              <staff xml:id="m1-staff-b3s1" n="1">
                <layer xml:id="m1-layer-b3s1l1" n="1">
                  <note xml:id="m1-p1v1-b3c1" pname="b" oct="5" dur="2" accid.ges="f"/>
