                <layer xml:id="m1-layer-b5s1l1" n="1">
                  <note xml:id="m1-p1v1-b5c1" pname="e" oct="5" dur="4" accid="f"/>
                  <note xml:id="m1-p1v1-b5c2" pname="d" oct="5" dur="4"/>
                  <note xml:id="m1-p1v1-b5c3" pname="c" oct="5" dur="4" accid="s"/>
