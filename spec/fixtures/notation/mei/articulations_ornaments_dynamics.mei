  <music>
    <body>
      <mdiv xml:id="m1" label="Marks and Dynamics">
        <score xml:id="m1-score">
          <scoreDef xml:id="m1-scoredef" keysig="1f" meter.count="3" meter.unit="4" midi.bpm="96">
            <staffGrp xml:id="m1-staffgrp">
              <staffDef xml:id="m1-staffdef-s1" n="1" lines="5">
                <label xml:id="m1-label-p1">Flute</label>
                <clef xml:id="m1-clef-s1" shape="G" line="2"/>
              </staffDef>
              <staffDef xml:id="m1-staffdef-s2" n="2" lines="5">
                <label xml:id="m1-label-p2">Cello</label>
                <clef xml:id="m1-clef-s2" shape="F" line="4"/>
              </staffDef>
            </staffGrp>
          </scoreDef>
          <section xml:id="m1-section">
            <measure xml:id="m1-measure-b1" n="1">
              <staff xml:id="m1-staff-b1s1" n="1">
                <layer xml:id="m1-layer-b1s1l1" n="1">
                  <note xml:id="m1-p1v1-b1c1" pname="c" oct="5" dur="4" artic="stacc"/>
                  <note xml:id="m1-p1v1-b1c2" pname="d" oct="5" dur="4" artic="stacc"/>
                  <note xml:id="m1-p1v1-b1c3" pname="e" oct="5" dur="4" artic="stacc"/>
