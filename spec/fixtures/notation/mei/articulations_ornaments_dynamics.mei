              </staff>
              <staff xml:id="m1-staff-b1s2" n="2">
                <layer xml:id="m1-layer-b1s2l1" n="1">
                  <note xml:id="m1-p2v1-b1c1" pname="f" oct="3" dur="2" artic="ten"/>
