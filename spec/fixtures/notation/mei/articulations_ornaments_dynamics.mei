                </layer>
              </staff>
              <dynam xml:id="m1-dynam-p1-b1c1" tstamp="1" staff="1">mp</dynam>
              <dynam xml:id="m1-dynam-p2-b1c1" tstamp="1" staff="2">p</dynam>
            </measure>
            <measure xml:id="m1-measure-b2" n="2">
